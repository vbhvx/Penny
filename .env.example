# PostgreSQL Database URL
DATABASE_URL="postgresql://username:password@localhost:5432/penny?schema=public"

# App Authentication & Session Secret
SESSION_SECRET="replace-with-a-secure-random-32-character-secret-key"

# Optional Gemini API Key for AI features (pure fallback is supported)
GEMINI_API_KEY=""

# Application Environment
NODE_ENV="development"
PORT=3000

